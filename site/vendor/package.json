{
  "name": "postcard-site-vendor",
  "private": true,
  "description": "The map libraries for the site, bundled at image build time (site/Dockerfile).",
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --format=iife --target=es2020 --legal-comments=none --outfile=dist/map.js && cp node_modules/maplibre-gl/dist/maplibre-gl.js node_modules/maplibre-gl/dist/maplibre-gl.css dist/"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.0",
    "@deck.gl/extensions": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/mapbox": "9.4.0",
    "@deck.gl/mesh-layers": "9.4.0",
    "d3-array": "3.2.4",
    "d3-geo": "3.1.1",
    "d3-scale": "4.0.2",
    "d3-selection": "3.0.0",
    "maplibre-gl": "5.24.0",
    "topojson-client": "3.1.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
